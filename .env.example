LLM_PROVIDER=groq                 # groq | openai | gemini | ollama
GROQ_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional overrides. Model catalogs change: verify IDs in your provider's model list.
# openai / gemini / ollama ship WITHOUT a default model, so set LLM_MODEL for them.
# LLM_MODEL=openai/gpt-oss-120b        # answer generation
# LLM_MODEL_FAST=openai/gpt-oss-20b    # planner + verifier
# LLM_BASE_URL=
# LLM_REASONING_EFFORT=low             # only sent to gpt-oss-style reasoning models
# LLM_JSON_MODE=auto                   # auto | off  (always off for gpt-oss)
# APP_TODAY=2026-09-21                 # freeze "today" (return windows are date-based)
